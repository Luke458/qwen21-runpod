+def _detach_conditioning(conditioning):
+    detached = []
+    for entry in conditioning:
+        if isinstance(entry, (list, tuple)) and len(entry) > 0 and isinstance(entry[0], torch.Tensor):
+            detached.append([entry[0].detach(), *entry[1:]])
+        else:
+            detached.append(entry)
+    return detached
